{
  "name": "banqi-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:api": "cd ../banqi-server && cargo test -p bqsrv-dto -p bqsrv-app export_bindings",
    "prebuild": "npm run generate:api",
    "build": "vue-tsc --noEmit && tsc -p src/scheduler --noEmit && vite build",
    "pretypecheck": "npm run generate:api",
    "typecheck": "vue-tsc --noEmit && tsc -p src/scheduler --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "antd": "^5.22.5",
    "dayjs": "^1.11.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
